{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/logs/log-.text",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "DatabaseOptions": {
    "MaxRetryCount": 3,
    "CommandTimeout": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": true
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Username=postgres;Password=postgres;Database=quizyzuna-db"
  },
  "Keycloak": {
    "AuthorizationUrl": "http://localhost:18080/realms/quizyzuna-auth/protocol/openid-connect/auth"
  },
  "Authentication": {
    "MetadataAdress": "http://keycloak:8080/realms/quizyzuna-auth/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:18080/realms/quizyzuna-auth",
    "Audience": "account"
  }
}